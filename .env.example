# ── Supabase (free tier: supabase.com → New Project) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed

# ── AI provider (swappable — see src/lib/ai/provider.ts) ──────
# CHAT provider (answers). EMBEDDINGS always stay on Gemini (free, 768-dim) so
# you can upgrade the chat model with ZERO re-ingestion — see AI_EMBED_PROVIDER.
AI_PROVIDER=gemini                 # gemini | openrouter | xai | selfhosted
GEMINI_API_KEY=your-gemini-key     # free at aistudio.google.com (also used for embeddings)
AI_CHAT_MODEL=gemini-flash-latest
AI_EMBEDDING_MODEL=gemini-embedding-001

# ── PREMIUM chat for the demo (recommended: OpenRouter — one key, many models)
# 1) Get a key at openrouter.ai/keys and add a few dollars of credit.
# 2) Uncomment the 4 lines below. Embeddings keep using GEMINI_API_KEY above.
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_CHAT_MODEL=x-ai/grok-4          # or google/gemini-2.5-pro, anthropic/claude-sonnet-4.5, openai/gpt-5
#
# Grok via your SuperGrok / X Premium+ subscription (OAuth — NO per-token key):
#   1) Run migration supabase/migrations/0013_grok_oauth.sql
#   2) Run `node scripts/grok-login.mjs` once (sign in with SuperGrok in browser)
#   3) Set the two lines below (locally + on Vercel) and redeploy.
# The server refreshes Grok access tokens from the refresh token stored in
# Supabase, so it works on Vercel from any device. Embeddings stay on Gemini.
# AI_PROVIDER=grok-oauth
# AI_CHAT_MODEL=grok-4     # confirm the exact id from the login script's output
#
# Grok direct (xAI) with a per-token API key instead:
# AI_PROVIDER=xai
# AI_BASE_URL=https://api.x.ai/v1
# AI_API_KEY=xai-...
# AI_CHAT_MODEL=grok-4
#
# Paid Gemini Pro (no code/keys change — just enable billing on the Google key):
# AI_CHAT_MODEL=gemini-2.5-pro
#
# Keep embeddings on free Gemini regardless of the chat provider (default).
# Only change this if you re-ingest ALL documents with a new embedding model.
# AI_EMBED_PROVIDER=gemini

# ── Voice input (Marathi dictation) ──────────────────────────
# Marathi voice typing uses Groq's free hosted Whisper (large-v3) for accuracy,
# with the browser's recognition as an instant preview + fallback. Get a free
# key at console.groq.com/keys. If unset, input silently uses the browser only.
GROQ_API_KEY=your-groq-key
# GROQ_STT_MODEL=whisper-large-v3   # or whisper-large-v3-turbo (faster)
# Read-aloud (speech output) has been removed.

# For openrouter / your own LLM later (OpenAI-compatible):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=महसूल संकेत
AI_CONFIDENCE_THRESHOLD=60
