# ── Supabase (free tier: supabase.com → New Project) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed

# ── AI provider (swappable — see src/lib/ai/provider.ts) ──────
AI_PROVIDER=gemini                 # gemini | openrouter | selfhosted
GEMINI_API_KEY=your-gemini-key     # free at aistudio.google.com
AI_CHAT_MODEL=gemini-flash-latest
AI_EMBEDDING_MODEL=gemini-embedding-001

# Voice: input (dictation) uses the browser's built-in speech recognition —
# no keys or server needed. Read-aloud (speech output) has been removed.

# For openrouter / your own LLM later (OpenAI-compatible):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=महसूल संकेत
AI_CONFIDENCE_THRESHOLD=60
